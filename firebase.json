{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/**",             "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/employee-portal/**", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/employee-login",     "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/request/**",         "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/request-respond/**", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/petty-cash/**",      "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/register",           "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "**",                  "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "store/**",
      "media/**",
      "uploads/**",
      "firebase-debug.log",
      ".env",
      ".env.*",
      "railway.json",
      "REFACTOR_PLAN.md",
      "serviceAccountKey.json"
    ]
  }
}
