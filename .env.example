# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Your deployed URL — used for invitation links, password reset links, and email callbacks
# On Railway this is your Railway domain, e.g. https://aladdinfinance-production.up.railway.app
APP_URL=https://your-railway-domain.up.railway.app

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave blank to allow same-origin only.
ALLOWED_ORIGINS=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Required for automated emails (reports, reminders, celebrations, invitations)
# Using Gmail: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Aladdin Finance <your-email@gmail.com>

# ── Google OAuth (Calendar, Drive, Gmail) ─────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match exactly what you set in Google Cloud Console → Authorized redirect URIs
GOOGLE_REDIRECT_URI=https://your-railway-domain.up.railway.app/api/events/gcal/callback

# Google Calendar ID (usually your Gmail address, or the calendar ID from Calendar settings)
GOOGLE_CALENDAR_ID=your-email@gmail.com

# Google Drive folder ID (from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=

# ── Optional integrations ─────────────────────────────────────────────────────
# QuickBooks (invoicing only — not used for client sync)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_ENVIRONMENT=production

# HubSpot
HUBSPOT_ACCESS_TOKEN=

# Zoom (for meeting scheduling)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
